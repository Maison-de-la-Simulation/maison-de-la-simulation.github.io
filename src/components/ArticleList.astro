---
import { content, href } from '../lib/content';
const {kind='all',category=''}=Astro.props;
const articles=content.filter(p=>(kind==='all'?['seminar','job'].includes(p.kind):p.kind===kind)).filter(p=>!category||p.classes.includes('category-'+category)).sort((a,b)=>b.date.localeCompare(a.date));
---
<div class="article-list">{articles.map(p=><article class="article-preview"><div><span class="pill">{p.label||(p.kind==='job'?'Recruitment · archive':'Seminar')}</span><time datetime={p.date}>Published on {new Date(p.date).toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'})}</time></div><h2><a href={href(p.path)}>{p.title}<span aria-hidden="true"> ↗</span></a></h2><p>{p.intro||p.text.slice(0,200)+(p.text.length>200?'…':'')}</p><a class="text-link" href={href(p.path)}>Read the full article →</a></article>)}</div>
