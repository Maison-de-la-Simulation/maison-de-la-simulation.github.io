---
import Base from '../layouts/Base.astro';
import ContactForm from './ContactForm.astro';
import {renderPartners} from '../lib/partners';
import { localize, href, content } from '../lib/content';
const { page, title=page?.title, intro=page?.intro||'' }=Astro.props;
const labels:Record<string,string>={member:'Directory',directory:'Our community',page:'The laboratory','glossary-entry':'Portrait',archive:'Archives'};
const classes: string[]=page?.classes||[];
const badges=classes.filter(c=>c.startsWith('member_category-')||c.startsWith('member_location-')).map(c=>{const key=c.replace(/^member_(category|location)-/,'');return ({'alumni':'Alumni','research-engineer':'Research engineering','research-director':'Research director','director':'Director','deputy-director':'Deputy director','assistante-de-direction':'Executive assistant','membres':'Member','phd':'PhD','postdoc':'Postdoc','associate-professor':'Associate professor','professor':'Professor','engineer':'Engineer','intern':'Internship','project-manager':'Project coordination'} as Record<string,string>)[key]||key.replaceAll('-',' ');});
const isProfile=['member','glossary-entry'].includes(page?.kind);
const directoryHtml=content.find(p=>p.kind==='directory')?.html||'';
const isMemberCategory=page?.path==='/category/member/';
let entries=content.filter(p=>(page?.path==='/glossary/'||page?.path?.startsWith('/tooltips_categories/'))?p.kind==='glossary-entry':p.kind==='member');
if(page?.path?.startsWith('/member_category/'))entries=entries.filter(p=>p.classes.includes('member_category-'+page.path.split('/')[2]));
if(page?.path?.startsWith('/member_location/'))entries=entries.filter(p=>p.classes.includes('member_location-'+page.path.split('/')[2]));
entries.sort((a,b)=>a.title.localeCompare(b.title,'en'));
---
<Base title={title} description={intro||page?.text?.slice(0,160)}><section class="page-head"><p class="eyebrow">MAISON DE LA SIMULATION / {page?.label||labels[page?.kind]||'RESOURCES'}</p><h1>{title}</h1>{intro&&<p class="intro">{intro}</p>}{badges.length>0&&<div class="profile-badges">{[...new Set(badges)].map(label=><span class="pill">{label}</span>)}</div>}</section>
<section class:list={['article-layout',{'profile-page':isProfile}]}>
{page?.toc?.length>2&&<aside class="toc"><p class="eyebrow">ON THIS PAGE</p><nav aria-label="Contents">{page.toc.map((h:{id:string,title:string})=><a href={'#'+h.id}>{h.title}</a>)}</nav></aside>}
<div class="source-content">
{(page?.kind==='directory'||isMemberCategory)&&<div class="directory-filter"><label for="member-search">Search the directory</label><div class="directory-search-row"><input id="member-search" type="search" placeholder="Name, team, role…" aria-controls="member-directory"/><button id="member-search-clear" type="button" hidden>Clear search</button></div><p id="member-search-status" role="status" aria-live="polite"></p><p id="member-search-empty" hidden>No members match your search. Try another name, team or role.</p></div>}
<div class:list={['migrated-content',{'editorial-content':page?.isEditorial}]} set:html={localize(page?.html||'').replace('__PARTNER_GRID__',renderPartners())}/>
{page?.originalHtml&&page.showOriginal&&<details class="original-version"><summary>{page.originalLabel}</summary><div class="migrated-content" lang="en" set:html={localize(page.originalHtml)}/></details>}
{page?.kind==='directory'&&<div class="quick-links"><a href={href('/member/')}>All member profiles →</a><a href={href('/glossary/')}>All portraits →</a></div>}
{page?.path==='/contact/'&&<ContactForm/>}
{page?.kind==='archive'&&!page.path.startsWith('/category/job/')&&<div class="complete-archives">{isMemberCategory?<div class="migrated-content" set:html={localize(directoryHtml)}/>:<><h2>Directory profiles</h2><div class="directory-archive">{entries.map(p=><a href={href(p.path)}><span>{p.title}</span><span aria-hidden="true">↗</span></a>)}</div></>}</div>}
{isProfile&&<a class="button ink" href={href('/members/')}>View the full directory →</a>}
</div></section></Base>
<script>
const search=document.querySelector<HTMLInputElement>('#member-search');
const normalize=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
const directory=document.querySelector<HTMLElement>('.members-directory');
const cards=Array.from(directory?.querySelectorAll<HTMLElement>('[data-member]')||[]);
const clear=document.querySelector<HTMLButtonElement>('#member-search-clear');
function updateDirectory(){
 if(!search||!directory)return;
 const query=normalize(search.value.trim());
 const terms=query.split(/\s+/).filter(Boolean);
 let matches=0;
 cards.forEach(card=>{
  const text=normalize(card.dataset.search||card.textContent||'');
  const match=terms.every(term=>text.includes(term));
  card.hidden=!match;
  if(match)matches++;
 });
 directory.querySelectorAll<HTMLElement>('[data-directory-group], [data-directory-section]').forEach(group=>{
  const entries=Array.from(group.querySelectorAll<HTMLElement>('[data-member]'));
  group.hidden=Boolean(query)&&!entries.some(card=>!card.hidden);
 });
 directory.querySelectorAll<HTMLAnchorElement>('.directory-sections a').forEach(link=>{
  const section=document.getElementById(link.hash.slice(1))?.closest<HTMLElement>('[data-directory-section]');
  link.hidden=Boolean(section?.hidden);
 });
 const status=document.querySelector('#member-search-status');
 if(status)status.textContent=matches+(query?' matching entries':' directory entries');
 const empty=document.querySelector<HTMLElement>('#member-search-empty');
 if(empty)empty.hidden=matches>0;
 if(clear)clear.hidden=!query;
}
search?.addEventListener('input',updateDirectory);
clear?.addEventListener('click',()=>{if(search){search.value='';updateDirectory();search.focus();}});
updateDirectory();
</script>
