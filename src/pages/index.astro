---
import Base from '../layouts/Base.astro';
import identity from '../data/identity.json';
import PartnerGrid from '../components/PartnerGrid.astro';
const media=identity.assets as Record<string,string>;
const image=(part:string)=>import.meta.env.BASE_URL+Object.entries(media).find(([url])=>url.includes(part))?.[1];
const b=import.meta.env.BASE_URL;
const themes=[
 ['01','High-performance computing','From algorithms to supercomputers: preparing applications for heterogeneous architectures.','science-of-computing/'],
 ['02','Data & artificial intelligence','Connecting simulation, data analysis and learning for science.','science-of-computing/'],
 ['03','Scientific visualisation','Exploring results, comparing simulations and making phenomena visible.','tiledviz-2/'],
 ['04','New computing paradigms','Exploring quantum computing, FPGAs and performance portability.','science-of-computing/'],
];
---
<Base>
<section class="hero"><div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> RESEARCH · EXPERTISE · TRAINING</p><h1>Computing for science,<br/><em>science for computing.</em></h1><p class="intro">Where science meets computing, we develop methods and software that open new possibilities for research.</p><div class="actions"><a class="button" href={b+'science-of-computing/'}>Explore our research <span>↗</span></a><a class="text-link" href={b+'laboratory/'}>Meet the laboratory →</a></div><div class="hero-meta"><span>MAISON DE LA SIMULATION</span><span>UAR 3441 · PARIS-SACLAY</span></div></div><figure class="hero-art hero-film"><div class="hero-video-viewport"><video id="science-video" controls autoplay muted loop playsinline preload="metadata" poster={b+'video/lwfa-poster.jpg'} aria-label="Laser–plasma interaction simulation, credit Francesco Massimo"><source src={b+'video/lwfa-francesco-massimo.mp4'} type="video/mp4"/>Your browser cannot play this video. <a href={b+'video/lwfa-francesco-massimo.mp4'}>Download the video</a>.</video></div><figcaption><span>SCIENCE IN MOTION</span><strong>Laser–plasma interaction</strong><span class="video-credit">Credit: Francesco Massimo</span></figcaption></figure></section>
<section class="section"><div class="section-heading"><div><p class="eyebrow">01 / OUR PURPOSE</p><h2>Connecting scientific<br/>challenges with computing.</h2></div><p>Physicists, mathematicians, computer scientists and engineers work together to support scientific communities.</p></div><div class="missions"><a href={b+'science-of-computing/'}><span class="number">01 — RESEARCH</span><h3>Develop new approaches.</h3><p>Bring numerical methods, programming models and scientific applications together.</p><span class="arrow">↗</span></a><a href={b+'science-by-computing/'}><span class="number">02 — EXPERTISE</span><h3>Advance scientific projects.</h3><p>Develop, port and optimise codes to make effective use of large computing infrastructures.</p><span class="arrow">↗</span></a><a href={b+'training/'}><span class="number">03 — TRAINING</span><h3>Share knowledge and tools.</h3><p>Train communities and share scientific computing practices.</p><span class="arrow">↗</span></a></div></section>
<section class="dark-section"><div class="section-heading"><div><p class="eyebrow">02 / RESEARCH AREAS</p><h2>Bringing expertise<br/>together.</h2></div><a class="text-link" href={b+'science-of-computing/'}>All research areas ↗</a></div><div class="theme-grid">{themes.map(([n,title,desc,path])=><a href={b+path}><span>{n}</span><div><h3>{title}</h3><p>{desc}</p></div><span class="arrow">↗</span></a>)}</div></section>
<section class="section software-feature"><div><p class="eyebrow">03 / TOOLS FOR THE COMMUNITY</p><h2>Research is built<br/>through software, too.</h2><p>Libraries, data tools and applications: software that advances scientific computing.</p><a class="button ink" href={b+'software/'}>Explore our software ↗</a></div><div class="code-list"><a href={b+'science-of-computing/#kokkos'}><strong>Kokkos</strong><span>Performance portability</span><b>↗</b></a><a href={b+'science-of-computing/#pdi'}><strong>PDI</strong><span>Data interface</span><b>↗</b></a><a href={b+'science-of-computing/#ddc'}><strong>DDC</strong><span>Meshes & C++ computing</span><b>↗</b></a></div></section>
<section class="news-strip"><p class="eyebrow">FEATURED · SCIENTIFIC WORKSHOP</p><a href={b+'de-lassistance-a-lautonomie-limpact-de-lia-agentique-sur-les-processus-de-recherche/'}><span>03 DEC. 2026</span><h2>From assistance to autonomy:<br/>agentic AI in research.</h2><b aria-hidden="true">↗</b></a></section>
<section class="section"><div class="section-heading"><div><p class="eyebrow">A LOOK INSIDE</p><h2>From simulations to people.</h2></div><a class="text-link" href={b+'members/'}>Meet our members ↗</a></div><div class="home-gallery"><img src={image('LWFA-fond-blanc-700x300.png')} alt="Laser–plasma interaction simulation" loading="lazy"/><img src={image('Weibel_3d_ne.0039-700x300.png')} alt="Visualisation of the Weibel instability" loading="lazy"/><img src={image('Inria-0204-089-1024x684-1-700x300.jpeg')} alt="Research activities at Maison de la Simulation" loading="lazy"/></div><div class="quick-links"><a href={b+'science-of-computing/'}>Science of Computing ↗</a><a href={b+'science-by-computing/'}>Science by Computing ↗</a><a href={b+'tiledviz-2/'}>TiledViz & VRWall ↗</a><a href={b+'seminars/'}>All seminars ↗</a></div></section><section class="section"><p class="eyebrow">SCIENTIFIC CONNECTIONS</p><h2>Working across communities.</h2><PartnerGrid/></section><section class="section closing"><p class="eyebrow">BUILDING WHAT COMES NEXT</p><h2>A scientific challenge?<br/><em>Let’s talk computing.</em></h2><a class="button ink" href={b+'contact/'}>Talk to the laboratory ↗</a></section>
<script>
const video=document.querySelector<HTMLVideoElement>('#science-video');
const reducedMotion=window.matchMedia('(prefers-reduced-motion: reduce)');
const respectMotion=()=>{if(reducedMotion.matches&&video){video.autoplay=false;video.pause();}};
respectMotion();reducedMotion.addEventListener('change',respectMotion);
</script>
</Base>