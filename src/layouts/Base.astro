---
import '../styles/global.css';
import identity from '../data/identity.json';
import tutelles from '../data/tutelles.json';
const {title='Maison de la Simulation',description='Research, expertise and training in high-performance computing, numerical simulation, artificial intelligence and quantum computing.',lang='en'}=Astro.props;
const base=import.meta.env.BASE_URL;
const link=(path='')=>`${base}${path}`;
const nav=[['Laboratory','laboratory/'],['Research','science-of-computing/'],['Expertise','science-by-computing/'],['Training','training/'],['Software','software/'],['Members','members/']];
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="theme-color" content="#0b2332"/><title>{title==='Maison de la Simulation'?title:`${title} · Maison de la Simulation`}</title><link rel="icon" type="image/png" href={link(identity.assets['https://mdls.fr/wp-content/uploads/2021/11/cropped-mdls_alpha_sans_texte_small-1024x1024-1-32x32.png'])}/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site)}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><link rel="sitemap" href={link('sitemap.xml')}/></head><body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header"><div class="identity-row"><a class="brand" href={base} aria-label="Maison de la Simulation — home"><img class="official-logo" src={link(identity.logo)} alt="Maison de la Simulation" width="1024" height="421"/></a><div class="header-tutelles" aria-label="Laboratory parent institutions">{tutelles.map(t=><a href={t.url} aria-label={t.name}><img src={link(t.image)} alt={t.name} width={t.width} height={t.height}/></a>)}</div></div><div class="navigation-row"><span class="lab-signature">RESEARCH · EXPERTISE · TRAINING</span><button class="menu" aria-expanded="false" aria-controls="navigation">Menu <span aria-hidden="true">☰</span></button><nav id="navigation" aria-label="Main navigation">{nav.map(([name,url])=><a href={link(url)} aria-current={Astro.url.pathname.endsWith('/'+url)?'page':undefined}>{name}</a>)}<a class="nav-search" href={link('search/')} aria-label="Search the website"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 6 6"/></svg></a><a class="nav-contact" href={link('contact/')}>Contact ↗</a></nav></div></header>
<main id="main"><slot/></main>
<footer><div class="footer-top"><div><a class="footer-brand" href={base}>Maison de la Simulation<span>Computing for science.</span></a><p>UAR 3441 · Campus Paris-Saclay<br/>Building 565 · PC 190 · Digiteo<br/>CEA Saclay · 91191 Gif-sur-Yvette cedex</p></div><div><h2>The laboratory</h2><a href={link('science-of-computing/')}>Science of Computing</a><a href={link('science-by-computing/')}>Science by Computing</a><a href={link('members/')}>Members & alumni</a><a href={link('jobs/')}>Join us</a><a href={link('how-to-come/')}>Visit us</a></div><div><h2>Explore</h2><a href={link('news/')}>News & seminars</a><a href={link('software/')}>Scientific software</a><a href={link('tiledviz-2/')}>TiledViz & VRWall</a><a href="https://hal-cea.archives-ouvertes.fr/MDLS/">Publications on HAL ↗</a><a href={link('site-map/')}>Site map</a><a href={link('credits/')}>Credits & information</a></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Maison de la Simulation</span><span>CEA · CNRS · Université Paris-Saclay · UVSQ</span></div></footer>
<script>const button=document.querySelector('.menu');const nav=document.querySelector('#navigation');button?.addEventListener('click',()=>{const open=button.getAttribute('aria-expanded')!=='true';button.setAttribute('aria-expanded',String(open));nav?.classList.toggle('open',open);});document.addEventListener('keydown',e=>{if(e.key==='Escape'){button?.setAttribute('aria-expanded','false');nav?.classList.remove('open');}});</script>
</body></html>
